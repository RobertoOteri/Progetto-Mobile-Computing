--- !u!114 &389280088
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 389280084}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 186803d2d9e1f3443800f38f50855412, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCTriggerDialogue
  firstContactZone: {fileID: 1091497819}
  interactPrompt: {fileID: 616819378}
  firstConversation:
  - speakerName: ???
    portrait: {fileID: 5739209855161057367, guid: e40539ef1a368ab409ed0e98db025d8e,
      type: 3}
    isRightSide: 1
    sentence: "\"\xA7#*! Mrow... zshhh krr-vok? Glx'par!\""
  - speakerName: Jack Orbit
    portrait: {fileID: 21300000, guid: ce7b3baa5bac4c5f908f345eea062c67, type: 3}
    isRightSide: 0
    sentence: '"C-cosa?! I sensori della compagnia spaziale davano questo pianeta
      per disabitato! Non capisco una singola parola..."'
  - speakerName: Jack Orbit
    portrait: {fileID: 21300000, guid: ce7b3baa5bac4c5f908f345eea062c67, type: 3}
    isRightSide: 0
    sentence: '"Aspetta... il modulo di esplorazione ha un decodificatore integrato.
      *Attivazione Traduttore Universale v4.2...*"'
  - speakerName: ???
    portrait: {fileID: 5739209855161057367, guid: e40539ef1a368ab409ed0e98db025d8e,
      type: 3}
    isRightSide: 1
    sentence: '"*bzzzt... Riconoscimento Fonetico attivo...* ...Uno spirito caduto
      dal cielo? Rispondi... sei alleato delle ombre che divorano questo suolo?"'
  - speakerName: Jack Orbit
    portrait: {fileID: 21300000, guid: ce7b3baa5bac4c5f908f345eea062c67, type: 3}
    isRightSide: 0
    sentence: '"Nessuno spirito, e non so di quali ombre tu stia parlando. Questo
      pianeta era la mia missione di esplorazione. Tu chi sei?"'
  - speakerName: Kael
    portrait: {fileID: 5739209855161057367, guid: e40539ef1a368ab409ed0e98db025d8e,
      type: 3}
    isRightSide: 1
    sentence: '"Io sono Kael. Hai poggiato i tuoi piedi sulle terre ancestrali dei
      Felariani."'
  - speakerName: Kael
    portrait: {fileID: 5739209855161057367, guid: e40539ef1a368ab409ed0e98db025d8e,
      type: 3}
    isRightSide: 1
    sentence: '"Un tempo eravamo un popolo pacifico, custodi dei grandi cristalli
      e dei segreti di questo mondo..."'
  - speakerName: Kael
    portrait: {fileID: 5739209855161057367, guid: e40539ef1a368ab409ed0e98db025d8e,
      type: 3}
    isRightSide: 1
    sentence: "\"Ma poi il sottosuolo si \xE8 risvegliato. Creature oscure e mostri
      fuori controllo hanno distrutto i nostri templi e decimato la mia gente.\""
  - speakerName: Jack Orbit
    portrait: {fileID: 21300000, guid: ce7b3baa5bac4c5f908f345eea062c67, type: 3}
    isRightSide: 0
    sentence: "\"Capisco... l'impatto dell'atterraggio \xE8 stato troppo violento
      e i miei reattori sono andati. Sono bloccato qui se non trovo una fonte di
      energia.\""
  - speakerName: Kael
    portrait: {fileID: 5739209855161057367, guid: e40539ef1a368ab409ed0e98db025d8e,
      type: 3}
    isRightSide: 1
    sentence: '"I tuoi congegni terrestri non troveranno carburante qui... ma i nostri
      Cristalli di Plasma possono risvegliare qualsiasi nucleo energetico."'
  - speakerName: Jack Orbit
    portrait: {fileID: 21300000, guid: ce7b3baa5bac4c5f908f345eea062c67, type: 3}
    isRightSide: 0
    sentence: '"Un cristallo di plasma potrebbe riavviare la navetta! Come posso
      ottenerne uno?"'
  - speakerName: Kael
    portrait: {fileID: 5739209855161057367, guid: e40539ef1a368ab409ed0e98db025d8e,
      type: 3}
    isRightSide: 1
    sentence: "\"Ti doner\xF2 il nostro cristallo se ci aiuti, anche solo in minima
      parte, a liberare il nostro pianeta da queste creature oscure.\""
  - speakerName: Jack Orbit
    portrait: {fileID: 21300000, guid: ce7b3baa5bac4c5f908f345eea062c67, type: 3}
    isRightSide: 0
    sentence: "\"Affare fatto. Trover\xF2 un modo per respingerle e dare una mano
      alla tua gente.\""
  - speakerName: Kael
    portrait: {fileID: 5739209855161057367, guid: e40539ef1a368ab409ed0e98db025d8e,
      type: 3}
    isRightSide: 1
    sentence: '"Che la luce del pianeta ti guidi, viaggiatore. Fa'' attenzione, quelle
      creature sono imprevedibili!"'
  repeatConversation:
  - speakerName: Kael
    portrait: {fileID: 5739209855161057367, guid: e40539ef1a368ab409ed0e98db025d8e,
      type: 3}
    isRightSide: 1
    sentence: "\"Sei ancora qui, viaggiatore? Ricorda il nostro patto: aiutaci a
      respingere queste creature oscure e il Cristallo di Plasma sar\xE0 tuo per
      riparare la nave.\""
  - speakerName: Jack Orbit
    portrait: {fileID: 21300000, guid: ce7b3baa5bac4c5f908f345eea062c67, type: 3}
    isRightSide: 0
    sentence: "\"Ci sto lavorando, Kael. Torno da te non appena l'area circostante
      sar\xE0 ripulita.\""
