  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9ccfe4f818a57274ea1630cb7c8c27f1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AutoDialogue
  speakerName: Jack Orbit
  portrait: {fileID: 21300000, guid: ce7b3baa5bac4c5f908f345eea062c67, type: 3}
  dialogueLines:
  - '"Diario di bordo, giorno 35. Sono finalmente sbarcato sulla superficie di C-137."'
  - '"Come indicato nei rilevamenti preliminari, la pressione atmosferica e i livelli
    di ossigeno sembrano ideali per la vita umana."'
  - '"I sensori non rilevano alcuna forma di vita intelligente nelle vicinanze...
    Perfetto. Il luogo sembra deserto e sicuro."'
  delayBeforeStart: 0.5
