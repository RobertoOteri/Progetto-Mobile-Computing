  m_Script: {fileID: 11500000, guid: 909ba50a78cb3b44fa9369c067200e1f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroSequence
  introText: {fileID: 78981869}
  textCanvasGroup: {fileID: 78981866}
  backgroundImage: {fileID: 0}
  imageCanvasGroup: {fileID: 648239630}
  sentences:
  - '"Diario di bordo, Anno 2670 D.C."'
  - "\"Quando l'umanit\xE0 ha scoperto il siero anti-invecchiamento, credevamo di
    aver vinto la morte.\""
  - "\"Ma l'immortalit\xE0 ha un prezzo. In pochi decenni, la Terra si \xE8 trasformata
    in una prigione soffocata dalla sovrappopolazione.\""
  - "\"Senza pi\xF9 spazio n\xE9 risorse, l'unica nostra salvezza rimasta era nascosta
    tra le stelle.\""
  - '"Sono stato scelto tra i pochi pionieri inviati nel buio dell''universo. Il
    mio compito: trovare un nuovo pianeta da colonizzare prima che sia troppo tardi..."'
  typingSpeed: 0.04
  displayDuration: 3
  fadeDuration: 1.5
  ambientFadeDuration: 1.5
  nextSceneName: Scena1
